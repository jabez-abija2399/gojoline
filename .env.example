# Copy to .env.local for local work. In the cloud, set these in the Vercel project
# and in the Claude Code cloud environment (never commit real values).

# AI (required for building and evals). The app reads this name and passes it to the
# Anthropic SDK explicitly: new Anthropic({ apiKey: process.env.SAYSITE_ANTHROPIC_API_KEY })
SAYSITE_ANTHROPIC_API_KEY=

# Database: Neon Postgres (required)
DATABASE_URL=

# Auth (Better Auth). Secret: 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in codes per IP per hour (default 10)
OTP_SEND_PER_IP_PER_HOUR=
# Sign-in code delivery (needs a provider account, see docs/ROADMAP.md "Blocked").
# Until set, production sign-in is closed; development prints codes in the server log.
SMS_PROVIDER=
SMS_API_TOKEN=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Sandbox: Vercel Sandbox (required for live preview)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Jobs and rate limits: Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Storage and publishing: Cloudflare R2 + Workers
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gojoline
CLOUDFLARE_API_TOKEN=
PUBLISH_BASE_DOMAIN=gojoline.site

# Telegram bot (from @BotFather). Bot name: gojoline, username: @gojoline_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gojoline_bot
TELEGRAM_WEBHOOK_SECRET=

# Payments: Chapa (later; not set up yet)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Errors
SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra HTTPS origins for the CSP (comma separated). Frames are blocked unless listed (set the preview origin here).
CSP_FRAME_ORIGINS=
CSP_CONNECT_ORIGINS=
CSP_IMAGE_ORIGINS=
# Per-IP waitlist submissions per minute (default 5)
WAITLIST_RATE_LIMIT_PER_MIN=5
# Vercel Sandbox base snapshot (template + node_modules). Create with:
#   node --experimental-strip-types scripts/sandbox-snapshot.mts
SANDBOX_SNAPSHOT_ID=
# Live AI/sandbox tests cost money; enable explicitly.
RUN_LLM_TESTS=0
# Optional overrides
AGENT_MODEL=
BUILDER_RATE_LIMIT_PER_HOUR=
