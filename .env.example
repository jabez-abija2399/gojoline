# Copy to .env.local for local work. In the cloud, set these in the Vercel project
# and in the Claude Code cloud environment (never commit real values).

# AI (required for building and evals). The app reads this name and passes it to the
# Anthropic SDK explicitly: new Anthropic({ apiKey: process.env.SAYSITE_ANTHROPIC_API_KEY })
SAYSITE_ANTHROPIC_API_KEY=

# Database: Neon Postgres (required)
DATABASE_URL=

# Auth (Better Auth). Secret: 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in codes per IP per hour (default 10)
OTP_SEND_PER_IP_PER_HOUR=
# Sign-in code delivery (needs a provider account, see docs/ROADMAP.md "Blocked").
# Until set, production sign-in is closed; development prints codes in the server log.
SMS_PROVIDER=
SMS_API_TOKEN=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Sandbox: Vercel Sandbox (required for live preview)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Jobs and rate limits: Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Vercel cron (/api/cron/visits rolls visit counts into Postgres daily). 16+ random characters;
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Visit counting itself uses the Upstash Redis above.
CRON_SECRET=

# Publishing on our own server (deploy/server): PUBLISH_PROVIDER=server writes sites to SITES_DIR
# (compose sets /srv/sites) for Caddy to serve at https://<name>.<PUBLISH_BASE_DOMAIN>. Wins over R2.
PUBLISH_PROVIDER=
SITES_DIR=
# Storage and publishing: Cloudflare R2 + the sites Worker (scripts/cloudflare-setup.mjs).
# With R2_* and PUBLISH_BASE_DOMAIN set, sites publish to https://<name>.<PUBLISH_BASE_DOMAIN>;
# without them, to the Vercel fallback (gojo-<name>.vercel.app).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gojoline
# Setup script only (founder's machine, never in Vercel): Workers, routes, DNS on the zone.
CLOUDFLARE_API_TOKEN=
# The app's token for customers' own domains: Zone · SSL and Certificates · Edit on the zone only.
CLOUDFLARE_SAAS_TOKEN=
# The zone's ID (the SaaS token can't look it up by name).
CLOUDFLARE_ZONE_ID=
PUBLISH_BASE_DOMAIN=afridea.et

# Telegram bot (from @BotFather). Bot name: gojoline, username: @gojoline_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gojoline_bot
TELEGRAM_WEBHOOK_SECRET=
# Admin → Posts: our public channel (the bot must be an admin there), e.g. @gojoline
TELEGRAM_CHANNEL_ID=
# Optional: the founder's chat id for the Monday summary
TELEGRAM_ADMIN_CHAT_ID=
# Optional: the model that writes post captions (default claude-haiku-5-5)
POSTS_MODEL=
# Admin → Posts videos: the renderer service (deploy/server/renderer). On the server, compose sets the URL;
# the secret falls back to SANDBOX_RUNNER_SECRET until RENDERER_SECRET (24+ characters) is set.
RENDERER_URL=
RENDERER_SECRET=
# Admin → Posts networks (docs/SOCIAL-SETUP.md). Each is used only when its values are set.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
# Instagram login token (no Facebook Page); saving it in Admin → Posts instead renews it by itself
INSTAGRAM_TOKEN=
META_GRAPH_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: a refresh token instead of "Connect TikTok" in Admin → Posts
TIKTOK_REFRESH_TOKEN=

# Payments: Chapa (later; not set up yet)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Errors
SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra HTTPS origins for the CSP (comma separated). Frames are blocked unless listed (set the preview origin here).
CSP_FRAME_ORIGINS=
CSP_CONNECT_ORIGINS=
CSP_IMAGE_ORIGINS=
# Per-IP waitlist submissions per minute (default 5)
WAITLIST_RATE_LIMIT_PER_MIN=5
# Vercel Sandbox base snapshot (template + node_modules). Create with:
#   node --experimental-strip-types scripts/sandbox-snapshot.mts
SANDBOX_SNAPSHOT_ID=
# Live AI/sandbox tests cost money; enable explicitly.
RUN_LLM_TESTS=0
# Optional overrides
AGENT_MODEL=
BUILDER_RATE_LIMIT_PER_HOUR=

# Billing (manual payments). Shown on the Plan page; without them the page says payments are coming soon.
PAYMENT_TELEBIRR_NUMBER=
PAYMENT_CBE_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
# Admins (comma separated, must sign in with a verified email or phone in this list).
ADMIN_EMAILS=
ADMIN_PHONES=

# Email (Resend). Sign-in codes and payment notices. The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Gojoline <login@afridea.et>
# Google sign-in (OAuth client; redirect URI https://<app>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
