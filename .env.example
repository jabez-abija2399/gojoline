# Copy to .env.local for local work. In the cloud, set these in the Vercel project
# and in the Claude Code cloud environment (never commit real values).

# AI (required for building and evals)
ANTHROPIC_API_KEY=

# Database: Neon Postgres (required)
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sandbox: Vercel Sandbox (required for live preview)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Jobs and rate limits: Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Storage and publishing: Cloudflare R2 + Workers
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gojoline
CLOUDFLARE_API_TOKEN=
PUBLISH_BASE_DOMAIN=gojoline.site

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Payments: Chapa (test keys until licensed)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Errors
SENTRY_DSN=
