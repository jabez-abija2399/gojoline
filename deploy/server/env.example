# Copy to /opt/gojoline/deploy/server/.env on the server and fill in (never commit it).
# Values: the same as the old Vercel project (Settings → Environment Variables).
# Write values as they are: no quotes, no spaces around =, no comments after a value.

# The public address (DNS A record → this server, "DNS only" in Cloudflare).
APP_DOMAIN=gojoline.afridea.et

# Required
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://gojoline.afridea.et
NEXT_PUBLIC_APP_URL=https://gojoline.afridea.et
SAYSITE_ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
ADMIN_EMAILS=
ADMIN_PHONES=

# Sign-in and email
RESEND_API_KEY=
EMAIL_FROM=Gojoline <login@afridea.et>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gojoline_bot
TELEGRAM_WEBHOOK_SECRET=
# Admin → Posts: our public channel (the bot must be an admin there), e.g. @gojoline
TELEGRAM_CHANNEL_ID=
# Optional: the founder's chat id for the Monday summary
TELEGRAM_ADMIN_CHAT_ID=
# Optional: the model that writes post captions (default claude-haiku-5-5)
POSTS_MODEL=
# Admin → Posts videos: the renderer service (deploy/server/renderer). On the server, compose sets the URL;
# the secret falls back to SANDBOX_RUNNER_SECRET until RENDERER_SECRET (24+ characters) is set.
RENDERER_URL=
RENDERER_SECRET=
# Admin → Posts networks (docs/SOCIAL-SETUP.md). Each is used only when its values are set.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: a refresh token instead of "Connect TikTok" in Admin → Posts
TIKTOK_REFRESH_TOKEN=

# Manual payments
PAYMENT_TELEBIRR_NUMBER=
PAYMENT_CBE_ACCOUNT=
PAYMENT_ACCOUNT_NAME=

# Site workspaces run on this server (deploy/server/runner); setup.sh makes this secret itself.
SANDBOX_RUNNER_SECRET=

# Customer sites on this server (README.md, "Customer sites"): https://<slug>.<PUBLISH_BASE_DOMAIN>,
# served by Caddy from the sites volume. Needs the wildcard DNS record first.
PUBLISH_PROVIDER=server
PUBLISH_BASE_DOMAIN=afridea.et
# Optional: keep these from Vercel so sites' old gojo-*.vercel.app addresses can forward to the
# new ones once Vercel answers again (scripts/republish-all.mts --forward-old, after 2026-12-19).
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Customer sites on Cloudflare R2 instead (after the Cloudflare setup in docs/ROADMAP.md;
# leave PUBLISH_PROVIDER empty then)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gojoline
CLOUDFLARE_SAAS_TOKEN=
CLOUDFLARE_ZONE_ID=

# Optional (only if set before)
SENTRY_DSN=
AGENT_MODEL=
