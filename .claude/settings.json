{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(next *)",
      "Bash(vite *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(drizzle-kit *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git -c push.negotiate=true push *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(python3 *)",
      "Bash(psql *)",
      "mcp__Neon",
      "mcp__Vercel",
      "mcp__Upstash_Redis",
      "mcp__Sentry"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "mcp__Neon__delete_project",
      "mcp__Neon__delete_branch",
      "mcp__Neon__delete_postgres_database",
      "mcp__Neon__delete_postgres_role",
      "mcp__Neon__reset_from_parent",
      "mcp__Vercel__delete_drive",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Upstash_Redis__redis_delete_database",
      "mcp__Upstash_Redis__redis_change_plan",
      "mcp__Upstash_Redis__redis_set_prod_pack",
      "mcp__Upstash_Redis__qstash_set_plan",
      "mcp__Upstash_Redis__index_delete"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] && [ ! -d node_modules ] && npm install --no-audit --no-fund >/dev/null 2>&1; true",
            "timeout": 600,
            "statusMessage": "Installing dependencies"
          }
        ]
      }
    ]
  }
}
