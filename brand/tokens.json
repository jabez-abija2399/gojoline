{
  "name": "Gojoline",
  "palette": "Paper and Coral",
  "color": {
    "paper": {
      "value": "#FBF9F6",
      "dark": "#121110",
      "use": "Page background"
    },
    "sunken": {
      "value": "#F6F2EC",
      "dark": "#0C0B0A",
      "use": "Inputs, wells, hover fills"
    },
    "panel": {
      "value": "#FFFFFF",
      "dark": "#181614",
      "use": "Cards and panels"
    },
    "line": {
      "value": "#E9E4DC",
      "dark": "#36312B",
      "use": "Borders and dividers"
    },
    "ink": {
      "value": "#121212",
      "dark": "#FBF9F6",
      "use": "Headings, body text, dark buttons and sections"
    },
    "ink-muted": {
      "value": "#5F5A53",
      "dark": "#A8A196",
      "use": "Secondary text"
    },
    "faint": {
      "value": "#8A847B",
      "dark": "#6E685F",
      "use": "Decorative only: icons, hover borders"
    },
    "link": {
      "value": "#C2370F",
      "dark": "#FF8A6B",
      "use": "Accent text, links, focus ring"
    },
    "coral": {
      "value": "#FF5B35",
      "dark": "#FF5B35",
      "use": "The one primary action. Text on it is ink, in both modes"
    },
    "coral-hover": {
      "value": "#FF7350",
      "dark": "#FF7350",
      "use": "Hover of coral"
    },
    "coral-soft": {
      "value": "#FFE9E2",
      "dark": "#3A1E16",
      "use": "Tinted surfaces and error backgrounds (derived from coral)"
    },
    "lagoon": {
      "value": "#0E7C66",
      "dark": "#3DD6B0",
      "use": "Live, success"
    },
    "warning": {
      "value": "#A3530A",
      "dark": "#FFB547",
      "use": "Warnings"
    },
    "danger": {
      "value": "#C81E3A",
      "dark": "#FF6B7F",
      "use": "Errors, destructive actions"
    },
    "sun": {
      "value": "#FFD23F",
      "dark": "#FFD23F",
      "use": "Highlight: fills only, never text"
    }
  },
  "font": {
    "display": "Outfit 700",
    "body": "Inter 400/500/600",
    "ethiopic": "Noto Sans Ethiopic 400/600/700"
  },
  "contrast": {
    "ink-on-coral": "6.5:1 (white on coral is 2.9:1 and must not be used)",
    "ink-on-paper": "17.9:1",
    "ink-muted-on-paper": "6.5:1",
    "link-on-paper": "5.2:1",
    "lagoon-on-paper": "4.9:1",
    "danger-on-paper": "5.5:1",
    "faint-on-paper": "3.6:1 (decoration only)"
  }
}
